# The hivetty-server base image's pins (HIVE-426). KEY=VALUE lines and `#` comments only:
# every KEY=VALUE line becomes a `--build-arg`. How to refresh them: packaging/server/README.md.

# The multi-arch index digest of debian:bookworm-slim
# (`docker buildx imagetools inspect debian:bookworm-slim`, its `Digest:` line).
DEBIAN_DIGEST=sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

# tini as bookworm ships it inside that base, the same on arm64 and amd64
# (`apt-cache policy tini`, its `Candidate:` line).
TINI_VERSION=0.19.0-1+b3
