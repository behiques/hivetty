exports[`the command line an agent wake runs (HIVE-337 pin) > container agent 1`] = `
{
  "args": [
    "-p",
    "--session-id",
    "11111111-2222-3333-4444-555555555555",
    "--name",
    "slack-watcher",
    "--settings",
    "/hive/container/claude-agent.settings.json",
    "--setting-sources",
    "",
    "--plugin-dir",
    "/hive/plugin",
    "--mcp-config",
    "/hive/container/hive.mcp.json",
    "--strict-mcp-config",
    "--allowedTools",
    "mcp__hive__ledger_*,mcp__hive__agents,mcp__hive__projects,mcp__hive__pr,mcp__hive__jira_get,mcp__hive__jira_users,mcp__hive__approve,Read,Grep",
    "--permission-prompt-tool",
    "mcp__hive__approve",
    "--max-turns",
    "40",
    "--append-system-prompt-file",
    "/hive/agents/slack-watcher.system.md",
    "--output-format",
    "stream-json",
    "--verbose",
    "You woke because: ledger. Read your ledger inbox, then carry out the instructions you were given. An empty inbox does not mean there is nothing to do — your instructions are standing work and this wake is one of the times to do them. End your turn when that work is done, or when you are waiting on an answer.",
  ],
  "container": {
    "command": "claude",
    "envArg": "-e {name}={value}",
    "name": "devbox",
    "runtime": "docker",
    "sessionUuid": "11111111-2222-3333-4444-555555555555",
    "workspace": "/work",
  },
  "cwd": "/home/me/.hive/work/slack-watcher",
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "HIVE_AGENT": "1",
    "HIVE_GRANTS": "["mcp__hive__ledger_*","mcp__hive__agents","mcp__hive__projects","mcp__hive__pr","mcp__hive__jira_get","mcp__hive__jira_users","mcp__hive__approve","ToolSearch","Read","Grep"]",
    "HIVE_HOOK_TOKEN": "tok",
    "HIVE_RECEIVER_URL": "http://host.docker.internal:5051",
    "HIVE_SESSION_ID": "slack-watcher",
  },
  "file": "claude",
  "namesConversation": true,
}
`;

