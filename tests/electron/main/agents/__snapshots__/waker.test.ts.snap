exports[`the command line an agent wake runs (HIVE-337 pin) > a one-shot grant 1`] = `
{
  "args": [
    "-p",
    "--session-id",
    "11111111-2222-3333-4444-555555555555",
    "--name",
    "slack-watcher",
    "--settings",
    "/u/hive/claude-hooks.settings.json",
    "--setting-sources",
    "",
    "--plugin-dir",
    "/u/hive/plugin",
    "--mcp-config",
    "/u/hive/hive.mcp.json",
    "--strict-mcp-config",
    "--allowedTools",
    "mcp__hive__ledger_*,mcp__hive__agents,mcp__hive__projects,mcp__hive__pr,mcp__hive__jira_get,mcp__hive__jira_users,mcp__hive__approve,Read,Grep",
    "--permission-prompt-tool",
    "mcp__hive__approve",
    "--max-turns",
    "40",
    "--append-system-prompt-file",
    "/u/hive/agents/slack-watcher.system.md",
    "--output-format",
    "stream-json",
    "--verbose",
    "You woke because: ledger. Read your ledger inbox, then carry out the instructions you were given. An empty inbox does not mean there is nothing to do — your instructions are standing work and this wake is one of the times to do them. End your turn when that work is done, or when you are waiting on an answer.",
  ],
  "cwd": "/home/me/.hive/work/slack-watcher",
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "HIVE_AGENT": "1",
    "HIVE_GRANTS": "["mcp__hive__ledger_*","mcp__hive__agents","mcp__hive__projects","mcp__hive__pr","mcp__hive__jira_get","mcp__hive__jira_users","mcp__hive__approve","ToolSearch","Read","Grep","Bash(git push:*)"]",
    "HIVE_HOOK_TOKEN": "tok",
    "HIVE_RECEIVER_URL": "http://127.0.0.1:5051",
    "HIVE_SESSION_ID": "slack-watcher",
    "HOME": "/home/me",
    "PATH": "/usr/bin",
  },
  "file": "/opt/bin/claude",
  "namesConversation": true,
}
`;

