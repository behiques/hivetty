// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`launchCodexHeadless > spells a first wake 1`] = `
[
  "exec",
  "--json",
  "--skip-git-repo-check",
  "--ignore-user-config",
  "--dangerously-bypass-hook-trust",
  "-m",
  "gpt-6-luna",
  "-c",
  "model_reasoning_effort="high"",
  "-c",
  "sandbox_mode="workspace-write"",
  "-c",
  "developer_instructions="You are \\"watcher\\".\\nBe \\\\brief\\\\."",
  "-c",
  "mcp_servers.hive.command="/Applications/HiveTTY.app/Contents/MacOS/HiveTTY"",
  "-c",
  "mcp_servers.hive.args=["/u/hive/mcp-host.js"]",
  "-c",
  "mcp_servers.hive.env={"ELECTRON_RUN_AS_NODE"="1"}",
  "-c",
  "mcp_servers.hive.env_vars=["HIVE_RECEIVER_URL","HIVE_SESSION_ID","HIVE_HOOK_TOKEN","HIVE_RUN_ID","HIVE_RUN_TOKEN","HIVE_GRANTS"]",
  "-c",
  "mcp_servers.hive.default_tools_approval_mode="approve"",
  "-c",
  "hooks.Stop=[{hooks=[{type="command",command="curl -sS -m 3 -X POST \\"$HIVE_RECEIVER_URL/hook\\" -H 'content-type: application/json' -H \\"x-hive-session: $HIVE_SESSION_ID\\" -H \\"x-hive-token: $HIVE_HOOK_TOKEN\\" --data-binary @- >/dev/null 2>&1 || true"}]}]",
  "-c",
  "hooks.PreToolUse=[{matcher="*",hooks=[{type="command",command="out=$(curl -sf -m 30 -X POST \\"$HIVE_RECEIVER_URL/fence\\" -H 'content-type: application/json' -H \\"x-hive-session: $HIVE_SESSION_ID\\" -H \\"x-hive-token: $HIVE_HOOK_TOKEN\\" -H \\"x-hive-run: $HIVE_RUN_ID\\" -H \\"x-hive-run-token: $HIVE_RUN_TOKEN\\" --data-binary @- 2>/dev/null) && [ -n \\"$out\\" ] && printf '%s' \\"$out\\" || printf '%s' '{\\"hookSpecificOutput\\":{\\"hookEventName\\":\\"PreToolUse\\",\\"permissionDecision\\":\\"deny\\",\\"permissionDecisionReason\\":\\"HiveTTY could not be reached to check this call, so it was not run. End your turn.\\"}}'"}]}]",
  "-c",
  "mcp_servers.hive_wake.enabled=false",
  "-c",
  "mcp_servers.hive_wake.command="new-uuid"",
  "You were woken.",
]
`;

exports[`launchCodexHeadless > spells a resume, without the instructions it keeps 1`] = `
[
  "exec",
  "resume",
  "thread-1",
  "--json",
  "--skip-git-repo-check",
  "--ignore-user-config",
  "--dangerously-bypass-hook-trust",
  "-c",
  "sandbox_mode="workspace-write"",
  "-c",
  "mcp_servers.hive.command="/Applications/HiveTTY.app/Contents/MacOS/HiveTTY"",
  "-c",
  "mcp_servers.hive.args=["/u/hive/mcp-host.js"]",
  "-c",
  "mcp_servers.hive.env={"ELECTRON_RUN_AS_NODE"="1"}",
  "-c",
  "mcp_servers.hive.env_vars=["HIVE_RECEIVER_URL","HIVE_SESSION_ID","HIVE_HOOK_TOKEN","HIVE_RUN_ID","HIVE_RUN_TOKEN","HIVE_GRANTS"]",
  "-c",
  "mcp_servers.hive.default_tools_approval_mode="approve"",
  "-c",
  "hooks.Stop=[{hooks=[{type="command",command="curl -sS -m 3 -X POST \\"$HIVE_RECEIVER_URL/hook\\" -H 'content-type: application/json' -H \\"x-hive-session: $HIVE_SESSION_ID\\" -H \\"x-hive-token: $HIVE_HOOK_TOKEN\\" --data-binary @- >/dev/null 2>&1 || true"}]}]",
  "-c",
  "hooks.PreToolUse=[{matcher="*",hooks=[{type="command",command="out=$(curl -sf -m 30 -X POST \\"$HIVE_RECEIVER_URL/fence\\" -H 'content-type: application/json' -H \\"x-hive-session: $HIVE_SESSION_ID\\" -H \\"x-hive-token: $HIVE_HOOK_TOKEN\\" -H \\"x-hive-run: $HIVE_RUN_ID\\" -H \\"x-hive-run-token: $HIVE_RUN_TOKEN\\" --data-binary @- 2>/dev/null) && [ -n \\"$out\\" ] && printf '%s' \\"$out\\" || printf '%s' '{\\"hookSpecificOutput\\":{\\"hookEventName\\":\\"PreToolUse\\",\\"permissionDecision\\":\\"deny\\",\\"permissionDecisionReason\\":\\"HiveTTY could not be reached to check this call, so it was not run. End your turn.\\"}}'"}]}]",
  "-c",
  "mcp_servers.hive_wake.enabled=false",
  "-c",
  "mcp_servers.hive_wake.command="thread-1"",
  "You were woken.",
]
`;
